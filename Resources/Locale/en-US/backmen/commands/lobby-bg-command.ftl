cmd-lobby_bg_next-desc = Switches the lobby background to the next one.
cmd-lobby_bg_next-help = Usage: lobby_bg_next
cmd-lobby_bg_next-none = No lobby backgrounds are available.
cmd-lobby_bg_next-success = Lobby background set to {$background}.

cmd-lobby_bg-desc = Shows or sets the current lobby background.
cmd-lobby_bg-help = Usage: lobby_bg [background]
cmd-lobby_bg-current = Current lobby background: {$background}
cmd-lobby_bg-none-current = none
cmd-lobby_bg-not-found = No lobby background exists with id {$background}.
cmd-lobby_bg-success = Lobby background set to {$background}.
cmd-lobby_bg-hint = <background>
