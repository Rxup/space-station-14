<?xml version="1.0" encoding="utf-8"?>
<!-- Backmen-only (maps still excluded). -->
<RunSettings>
  <NUnit>
    <NumberOfTestWorkers>1</NumberOfTestWorkers>
    <DefaultTestNamePattern>{m}{a}</DefaultTestNamePattern>
  </NUnit>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TestCaseFilter>FullyQualifiedName~Backmen&amp;TestCategory!=CiMaps</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
